# Exasol Connection Configuration
EXASOL_DSN=127.0.0.1:8563
EXASOL_SYS_PASSWORD_FILE=~/.exasol-starter-kit/credentials/nano_sys_password
# Optional direct sys password override
# EXASOL_PASSWORD=

# Role Passwords (generated by `talos init` if unset)
TALOS_LOADER_PASSWORD=change_me_loader_password
TALOS_PIPELINE_PASSWORD=change_me_pipeline_password
TALOS_APPROVER_PASSWORD=change_me_approver_password
TALOS_READER_PASSWORD=change_me_reader_password
TALOS_EVAL_PASSWORD=change_me_eval_password

# Web Application Session Secret
TALOS_SESSION_SECRET=change_me_session_secret_at_least_32_chars

# LLM Judge Configuration (stub or provider:model)
TALOS_JUDGE=stub
